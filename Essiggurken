<!DOCTYPE html>

<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>🥒 Die Welt der Essiggurken</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #f3f7f0;
    color: #263126;
    line-height: 1.6;
}

/* Kopfbereich */
header {
    background: #31572c;
    color: white;
    text-align: center;
    padding: 55px 20px;
}

header h1 {
    font-size: 45px;
    margin-bottom: 10px;
}

header p {
    font-size: 19px;
}

/* Navigation */
nav {
    background: #1f3d1c;
    text-align: center;
    padding: 15px;
    position: sticky;
    top: 0;
    z-index: 10;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 15px;
    font-weight: bold;
}

nav a:hover {
    color: #b7e4a8;
}

/* Inhalt */
.container {
    max-width: 1050px;
    margin: auto;
    padding: 30px 20px;
}

section {
    background: white;
    padding: 30px;
    margin-bottom: 25px;
    border-radius: 15px;
    box-shadow: 0 4px 14px rgba(0,0,0,0.08);
}

h2 {
    color: #31572c;
    margin-bottom: 15px;
    font-size: 28px;
}

h3 {
    color: #477a3d;
    margin-top: 20px;
    margin-bottom: 8px;
}

/* Startseite */
.hero {
    text-align: center;
    padding: 45px 25px;
}

.gurke {
    font-size: 80px;
    margin-bottom: 10px;
}

.hero h2 {
    font-size: 34px;
}

/* Karten */
.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
}

.card {
    background: #edf6e9;
    padding: 22px;
    border-radius: 12px;
    border: 2px solid transparent;
    transition: 0.2s;
}

.card:hover {
    border-color: #6a994e;
    transform: translateY(-3px);
}

/* Zutaten */
.zutaten {
    background: #f5f8f3;
    padding: 20px;
    border-radius: 10px;
}

.zutaten li {
    margin: 7px 0;
    margin-left: 25px;
}

/* Herstellung */
.schritte {
    counter-reset: schritt;
}

.schritt {
    margin: 15px 0;
    padding: 18px;
    background: #edf6e9;
    border-radius: 10px;
}

/* Fakten */
.fakt {
    background: #fff8dc;
    border-left: 5px solid #d4a017;
    padding: 18px;
    margin-top: 15px;
    border-radius: 5px;
}

/* Quiz */
.question {
    background: #f5f8f3;
    padding: 20px;
    margin-top: 18px;
    border-radius: 10px;
}

button {
    background: #477a3d;
    color: white;
    border: none;
    padding: 12px 18px;
    margin: 7px 5px 0 0;
    border-radius: 8px;
    cursor: pointer;
    font-size: 15px;
}

button:hover {
    background: #31572c;
}

.result {
    margin-top: 12px;
    font-weight: bold;
}

#score {
    font-size: 20px;
    font-weight: bold;
    color: #31572c;
}

/* Footer */
footer {
    background: #1f3d1c;
    color: white;
    text-align: center;
    padding: 25px;
    margin-top: 20px;
}

/* Handy */
@media (max-width: 650px) {

    header h1 {
        font-size: 32px;
    }

    nav a {
        display: block;
        margin: 8px;
    }

    .gurke {
        font-size: 60px;
    }
}
</style>

</head>

