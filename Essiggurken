<script>

let score = 0;
let answered = {};

function check(question, correct) {

    if (answered[question]) {
        return;
    }

    answered[question] = true;

    const result = document.getElementById("r" + question);

    if (correct) {

        score++;

        result.textContent = "✅ Richtig!";
        result.style.color = "green";

    } else {

        result.textContent = "❌ Falsch!";
        result.style.color = "red";

    }

    document.getElementById("score").textContent =
        "Punkte: " + score + " / 5";
}


function resetQuiz() {

    score = 0;
    answered = {};

    document.getElementById("score").textContent =
        "Punkte: 0 / 5";

    for (let i = 1; i <= 5; i++) {

        document.getElementById("r" + i).textContent = "";

    }

}

</script>

